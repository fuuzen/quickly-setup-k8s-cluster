all:
  vars:
    k8s_user: <k8s-user>
  children:
    control_nodes:
      hosts:
        control_node:
          ansible_host: <host-1>
          ansible_user: "{{ k8s_user }}"
    worker_nodes:
      hosts:
        worker_node_1:
          ansible_host: <host-2>
          ansible_user: "{{ k8s_user }}"
        worker_node_2:
          ansible_host: <host-3>
          ansible_user: "{{ k8s_user }}"
    # 向已有集群加入新的 worker 时在这里配置：
    # new_workers:
    #   hosts:
    #     worker_node_3:
    #       ansible_host: <host-4>
    #       ansible_user: "{{ k8s_user }}"